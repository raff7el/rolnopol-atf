# Copy this file to .env and adjust the values. Never commit .env.

# URL of the Rolnopol app under test
BASE_URL=http://localhost:3000

# Seeded demo user with no farm data (used by createUser() / createUser("empty"))
TEST_EMPTY_USER_EMAIL=
TEST_EMPTY_USER_PASSWORD=

# Display name of that user, as shown on the profile page
TEST_EMPTY_USER_DISPLAY_NAME=

# Seeded main demo farmer with sample fields, staff, animals and money (used by createUser("demo"))
TEST_DEMO_USER_EMAIL=
TEST_DEMO_USER_PASSWORD=

# Display name of that user, as shown on the profile page
TEST_DEMO_USER_DISPLAY_NAME=
