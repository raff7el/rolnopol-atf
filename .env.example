# Copy this file to .env and adjust the values. Never commit .env.
# All variables below are required - see src/config/env.ts.

# URL of the Rolnopol app under test
BASE_URL=http://localhost:3000

# Credentials of an existing test user (used by createUser())
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# Display name of that user, as shown on the profile page
TEST_USER_DISPLAY_NAME=
